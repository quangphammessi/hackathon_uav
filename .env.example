# Copy to .env and adjust. Every value has a working default, so an empty
# .env still brings up a functioning stack.

# --- adapter selection -----------------------------------------------------
# EVENT_BUS_BACKEND    kafka | redis | memory
# FEATURE_STORE_BACKEND redis | memory
# PRODUCT_STORE_BACKEND postgres | json
# VECTOR_STORE_BACKEND  pgvector | tfidf
# EMBEDDINGS_BACKEND    ollama | hash
EVENT_BUS_BACKEND=kafka
EMBEDDINGS_BACKEND=ollama

# --- infrastructure --------------------------------------------------------
DATABASE_URL=postgresql://agentmarket:agentmarket@localhost:5432/agentmarket
REDIS_URL=redis://localhost:6379/0
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- local LLM (Ollama) ----------------------------------------------------
# Compose runs Ollama for you and pulls both models. Running outside Compose:
#   ollama serve && ollama pull llama3.2 && ollama pull nomic-embed-text
# Set AGENTMARKET_LLM_PROVIDER=none to force the deterministic keyword planner.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# --- UI --------------------------------------------------------------------
# Resolved by the browser, so it is localhost even inside Compose.
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8080

# --- secrets ---------------------------------------------------------------
AGENTMARKET_JWT_SECRET=change-me-in-production
